{
    "name": "bizhub/ember",
    "description": "AI summarization, chat, and RAG package for Laravel",
    "type": "library",
    "version": "0.1",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^11.0",
        "prism-php/prism": "^0.87.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "Bizhub\\Ember\\": "src/",
            "Bizhub\\Ember\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bizhub\\Ember\\EmberServiceProvider"
            ],
            "aliases": {
                "Ember": "Bizhub\\Ember\\Ember"
            }
        }
    }
}
